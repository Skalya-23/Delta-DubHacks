# CommitBench / Delta backend (Jetson). Copy this to .env and fill in real values.

# Perceptron Mk1 (scene detection)
PERCEPTRON_API_KEY=your-perceptron-api-key-here
PERCEPTRON_ENDPOINT=https://api.perceptron.inc/v1/chat/completions

# Supabase: same project as frontend/.env.local (Project Settings -> API Keys).
# The secret key bypasses RLS; keep it on the Jetson only, never in the frontend.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Optional tuning (defaults were measured on the Jetson Orin Nano + C920)
# CAMERA_INDEX=0
# IGNORE_BORDER_PX=84         # strip along all 4 edges that isn't tracked (~1 inch at the current mount)
# MOTION_THRESHOLD=400        # frame-to-frame pixels that count as 'a hand is moving'
# PERCEPTRON_REASONING=low    # low: ~5s/call, same parts found as high (11-25s)
# PERCEPTRON_MAX_TOKENS=3000
